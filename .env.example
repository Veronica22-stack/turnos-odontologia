# Plantilla de variables de entorno. Copiar a `.env` (no versionado) y completar.
# Spring Boot NO lee `.env` por si solo: ver README ("Desarrollo local") para cargarlo en la consola o en el IDE.
# Nunca poner valores reales en este archivo. `change-me` marca un secreto que cada integrante debe definir.

# --- Perfil (C-01) ---
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos (C-01) ---
# Nombre de la base: lo usa el script infra/postgres/init/01-roles.sql (variable de psql `db_name`).
DB_NAME=consultorio
DB_URL=jdbc:postgresql://localhost:5432/consultorio
# Rol de la aplicacion (solo DML, sin DDL)
DB_USER=app
DB_PASSWORD=change-me
# Rol con DDL, usado solo por Flyway
DB_MIGRATION_USER=migrator
DB_MIGRATION_PASSWORD=change-me

# --- Aplicacion (C-02, C-04) ---
# Alta inicial del odontologo: lo consume C-02
# Usuario odontólogo inicial (C-02). Se usan SOLO en el primer arranque,
# cuando todavía no existe ningún odontólogo; después se ignoran.
# La contraseña debe tener al menos 12 caracteres. Al primer ingreso se obliga a cambiarla.
BOOTSTRAP_ADMIN_EMAIL=change-me
BOOTSTRAP_ADMIN_PASSWORD=change-me
# URL publica (links en emails) y zona horaria del consultorio: C-02
APP_BASE_URL=http://localhost:5173
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Expiracion de sesion por inactividad: C-04
AUTH_SESSION_TIMEOUT_MIN=30
# Cookie opaca de sesion: C-04. Secure=false solo en el perfil dev (HTTP local).
AUTH_SESSION_COOKIE_NAME=SESSIONID
AUTH_SESSION_COOKIE_SECURE=true
# Origenes permitidos (CORS): C-04
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Reserva publica (C-08 y posteriores) ---
RATE_LIMIT_PUBLIC_PER_MIN=30
BOOKING_TOKEN_TTL_DAYS=1

# --- Email (C-13) ---
# En desarrollo los emails se escriben en el log, sin envio (DD-10).
MAIL_PROVIDER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=change-me
MAIL_FROM=turnos@ejemplo.com
REMINDER_HOURS_BEFORE=24
